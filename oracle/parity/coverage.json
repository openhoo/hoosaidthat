    {
      "actions": ["nextVisitedLink", "previousVisitedLink"],
      "expected": "Chrome for Testing 151 exposes no visited-link quick-navigation target to NVDA in the isolated oracle profile; exact English and German boundary presentation is asserted."
    },
    {
      "actions": ["nextSpellingError", "previousSpellingError"],
      "expected": "Chrome for Testing 151 IA2 reports spelling quick navigation as unsupported; exact English and German boundary presentation is asserted."
    },
    {
      "actions": ["nextReference", "previousReference"],
      "expected": "NVDA 2026.1.1's Chromium IA2 virtual buffer does not implement reference quick navigation; exact localized unsupported presentation is asserted."
    },
    {
      "actions": ["exitEmbeddedObject"],
      "expected": "Chrome for Testing 151 exposes an iframe inside the containing page's NVDA tree interceptor, not as a nested tree interceptor. NVDA+Control+Space therefore completes without moving focus; silence or unchanged frame braille is asserted."
    },
    {
      "actions": ["reviewPreviousPage", "reviewNextPage"],
      "expected": "Chromium's editable-text NVDA object may not expose page text units. Exact localized unsupported output is accepted alongside real page movement when the backend provides it."
    }
