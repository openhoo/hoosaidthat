{
  "name": "@openhoo/hoosaidthat",
  "version": "0.1.0",
  "description": "Real screen-reader testing fixtures, assertions, and visual evidence for Playwright.",
  "type": "module",
  "license": "MIT",
  "author": "Hoo Said That contributors",
  "homepage": "https://github.com/openhoo/hoosaidthat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoo/hoosaidthat.git"
  },
  "bugs": {
    "url": "https://github.com/openhoo/hoosaidthat/issues"
  },
  "keywords": [
    "playwright",
    "accessibility",
    "a11y",
    "screenreader",
    "screen-reader",
    "orca",
    "nvda",
    "windows",
    "hoovda",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hoosaidthat-nvda-windows": "./scripts/nvda-windows.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "images/*/README.md",
    "images/*/runtime-contract.json",
    "oracle/windows-nvda",
    "oracle/parity",
    "!oracle/**/__pycache__",
    "!oracle/**/*.pyc",
    "scripts/hoovda-parity.mjs",
    "scripts/nvda-windows.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:python": "python3 -m unittest discover -s images/orca/tests -v",
    "test:e2e:orca": "npm run build && playwright test --config examples/basic/playwright.config.ts",
    "test:e2e:hoovda": "npm run build && SCREEN_READER=hoovda SCREEN_READER_IMAGE=hoosaidthat-hoovda:dev playwright test --config examples/basic/playwright.config.ts",
    "test:e2e:hoovda:oracle": "npm run build && SCREEN_READER=hoovda SCREEN_READER_IMAGE=hoosaidthat-hoovda:dev playwright test --config examples/basic/playwright.config.ts --grep 'oracle'",
    "test:e2e:hoovda:parity": "npm run build && node scripts/hoovda-parity.mjs",
    "test:e2e": "npm run test:e2e:orca && npm run test:e2e:hoovda",
    "test": "npm run clean && npm run build && npm run test:unit && npm run test:python",
    "pack:check": "npm pack --dry-run",
    "image:build:orca": "podman build --format docker --tag hoosaidthat-orca:dev --file images/orca/Dockerfile .",
    "image:smoke:orca": "bash images/orca/smoke-test.sh hoosaidthat-orca:dev orca",
    "image:build:hoovda-engine": "podman build --format docker --platform linux/amd64 --tag hoovda-engine:dev ../hoovda",
    "image:build:hoovda": "npm run image:build:hoovda-engine && podman build --format docker --platform linux/amd64 --tag hoosaidthat-hoovda:dev --file images/hoovda/Dockerfile .",
    "image:smoke:hoovda": "bash images/hoovda/smoke-test.sh hoosaidthat-hoovda:dev",
    "nvda:windows:doctor": "node scripts/nvda-windows.mjs doctor",
    "nvda:windows:init": "node scripts/nvda-windows.mjs init",
    "nvda:windows:up": "node scripts/nvda-windows.mjs up",
    "nvda:windows:wait": "node scripts/nvda-windows.mjs wait",
    "nvda:windows:wait-ssh": "node scripts/nvda-windows.mjs wait-ssh",
    "nvda:windows:status": "node scripts/nvda-windows.mjs status",
    "nvda:windows:control": "node scripts/nvda-windows.mjs control",
    "nvda:windows:sync": "node scripts/nvda-windows.mjs sync",
    "nvda:windows:parity": "node scripts/nvda-windows.mjs parity",
    "nvda:windows:parity-cell": "node scripts/nvda-windows.mjs parity-cell",
    "nvda:windows:down": "node scripts/nvda-windows.mjs down"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
