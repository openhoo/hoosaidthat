{
  "name": "@openhoo/hoosaidthat",
  "version": "0.1.4",
  "description": "Real screen-reader testing fixtures, assertions, and visual evidence for Playwright.",
  "type": "module",
  "license": "MIT",
  "author": "Hoo Said That contributors",
  "homepage": "https://github.com/openhoo/hoosaidthat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhoo/hoosaidthat.git"
  },
  "bugs": {
    "url": "https://github.com/openhoo/hoosaidthat/issues"
  },
  "keywords": [
    "playwright",
    "accessibility",
    "a11y",
    "screenreader",
    "screen-reader",
    "orca",
    "nvda",
    "windows",
    "hoovda",
    "testing",
    "talkback",
    "android",
    "voiceover",
    "macos",
    "ios",
    "iphone",
    "jaws"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ios": {
      "types": "./scripts/voiceover-ios.d.mts",
      "import": "./scripts/voiceover-ios.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hoosaidthat-nvda-windows": "./scripts/nvda-windows.mjs",
    "hoosaidthat-talkback-android": "./scripts/talkback-android.mjs",
    "hoosaidthat-native": "./scripts/native-screen-reader.mjs",
    "hoosaidthat-voiceover-macos": "./scripts/voiceover-macos.mjs",
    "hoosaidthat-hoovda-doctor": "./scripts/hoovda-doctor.mjs",
    "hoosaidthat-voiceover-ios": "./scripts/voiceover-ios.mjs",
    "hoosaidthat-windows-reader": "./scripts/windows-reader-docker.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "images/*/README.md",
    "images/*/runtime-contract.json",
    "images/*/source.json",
    "oracle/windows-nvda",
    "!oracle/windows-nvda/tests/**",
    "oracle/parity",
    "!oracle/**/__pycache__",
    "!oracle/**/*.pyc",
    "scripts/hoovda-parity.mjs",
    "scripts/check-hoovda-source.mjs",
    "scripts/nvda-windows.mjs",
    "scripts/verify-web-report.mjs",
    "README.md",
    "LICENSE",
    "scripts/talkback-android.mjs",
    "scripts/build-talkback.mjs",
    "scripts/native/commands.mjs",
    "scripts/native/server.mjs",
    "scripts/native/token.mjs",
    "scripts/native/talkback.mjs",
    "scripts/native/android-devtools.mjs",
    "scripts/native/android-emulator.mjs",
    "scripts/native/prepare-talkback-emulator.mjs",
    "scripts/native/emulator-keyboard.mjs",
    "oracle/android-talkback",
    "!oracle/android-talkback/build",
    "scripts/native-screen-reader.mjs",
    "scripts/voiceover-macos.mjs",
    "scripts/native/at-driver.mjs",
    "scripts/native/voiceover.mjs",
    "scripts/native/focus-macos.js",
    "scripts/native/platform.mjs",
    "oracle/macos-voiceover",
    "oracle/native-check",
    "scripts/hoovda-doctor.mjs",
    "scripts/voiceover-ios.mjs",
    "scripts/voiceover-ios.d.mts",
    "oracle/ios-voiceover/HooSaidThat.xcodeproj/project.pbxproj",
    "oracle/ios-voiceover/HooSaidThat.xcodeproj/xcshareddata/xcschemes/HooSaidThat.xcscheme",
    "oracle/ios-voiceover/*.swift",
    "oracle/ios-voiceover/*.m",
    "oracle/ios-voiceover/*.h",
    "scripts/windows-reader-docker.mjs",
    "oracle/windows-jaws",
    "!oracle/windows-jaws/tests/**",
    "scripts/native/focus-windows.ps1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.parity.json && node scripts/build-parity.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:python": "python3 -m unittest discover -s images/orca/tests -v",
    "test:python:nvda": "python3 -m unittest discover -s oracle/windows-nvda/tests -v",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:session-browser": "tsc -p tsconfig.test.json && node --test .test-dist/tests/session-browser.smoke.js",
    "test:report-edges": "npm run build && node scripts/verify-report-edge-cases.mjs",
    "test:e2e:orca": "npm run build && playwright test --config examples/basic/playwright.config.ts",
    "test:e2e:hoovda": "npm run build && SCREEN_READER=hoovda playwright test --config examples/basic/playwright.config.ts",
    "test:e2e:hoovda:oracle": "npm run build && SCREEN_READER=hoovda playwright test --config examples/basic/playwright.config.ts --grep 'oracle'",
    "test:e2e:hoovda:parity": "npm run build && node scripts/hoovda-parity.mjs",
    "test:e2e": "npm run test:e2e:orca && npm run test:e2e:hoovda",
    "test": "npm run clean && npm run build && npm run test:unit && npm run test:python && npm run test:python:nvda && npm run test:scripts",
    "pack:check": "npm pack --dry-run",
    "image:build:orca": "podman build --format docker --tag hoosaidthat-orca:dev --file images/orca/Dockerfile .",
    "image:smoke:orca": "bash images/orca/smoke-test.sh hoosaidthat-orca:dev orca",
    "image:build:hoovda-engine": "podman build --format docker --platform linux/amd64 --tag hoovda-engine:dev ../hoovda",
    "image:build:hoovda": "npm run image:build:hoovda-engine && podman build --format docker --platform linux/amd64 --tag hoosaidthat-hoovda:dev --file images/hoovda/Dockerfile .",
    "image:smoke:hoovda": "bash images/hoovda/smoke-test.sh hoosaidthat-hoovda:dev",
    "nvda:windows:doctor": "node scripts/nvda-windows.mjs doctor",
    "nvda:windows:init": "node scripts/nvda-windows.mjs init",
    "nvda:windows:up": "node scripts/nvda-windows.mjs up",
    "nvda:windows:wait": "node scripts/nvda-windows.mjs wait",
    "nvda:windows:wait-ssh": "node scripts/nvda-windows.mjs wait-ssh",
    "nvda:windows:status": "node scripts/nvda-windows.mjs status",
    "nvda:windows:control": "node scripts/nvda-windows.mjs control",
    "nvda:windows:sync": "node scripts/nvda-windows.mjs sync",
    "nvda:windows:parity": "node scripts/nvda-windows.mjs parity",
    "nvda:windows:parity-cell": "node scripts/nvda-windows.mjs parity-cell",
    "nvda:windows:parity-shard": "node scripts/nvda-windows.mjs parity-shard",
    "nvda:windows:down": "node scripts/nvda-windows.mjs down",
    "test:e2e:report": "npm run build && SCREEN_READER=hoovda SCREEN_READER_WEB_REPORT=on playwright test --config examples/basic/playwright.config.ts --grep \"annotated website report\"",
    "test:report-viewer": "node scripts/verify-web-report.mjs",
    "talkback:android:build": "node scripts/build-talkback.mjs",
    "talkback:android:doctor": "node scripts/talkback-android.mjs doctor",
    "talkback:android:start": "node scripts/talkback-android.mjs start",
    "talkback:android:run": "node scripts/talkback-android.mjs run",
    "test:e2e:talkback": "npm run build && playwright test --config oracle/android-talkback/playwright.config.mjs",
    "native:start": "node scripts/native-screen-reader.mjs",
    "test:e2e:native": "npm run build && playwright test --config examples/native/playwright.config.ts",
    "voiceover:macos:doctor": "node scripts/voiceover-macos.mjs doctor",
    "voiceover:macos:init": "node scripts/voiceover-macos.mjs init",
    "voiceover:macos:run": "node scripts/voiceover-macos.mjs run",
    "voiceover:macos:status": "node scripts/voiceover-macos.mjs status",
    "voiceover:macos:stop": "node scripts/voiceover-macos.mjs stop",
    "hoovda:check": "node scripts/check-hoovda-source.mjs",
    "nvda:windows:qualification": "node scripts/nvda-windows.mjs qualification",
    "voiceover:ios:doctor": "node scripts/voiceover-ios.mjs doctor",
    "voiceover:ios:run": "node scripts/voiceover-ios.mjs run",
    "windows:reader": "node scripts/windows-reader-docker.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <1.65.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
